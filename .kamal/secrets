# Secrets for shettar-super Kamal production deploys.
# Loaded on your laptop before the build (not from the remote git clone).
#
# - config/registry.yml → Docker Hub token
# - .env.production     → optional NEXT_PUBLIC_* passed as Docker --build-arg
#
# IMPORTANT: This file is dotenv, not a shell script. No if/fi/else.

# Docker Hub PAT — strip trailing newline (newline breaks docker login -p).
# Do NOT use tr -d '\r\n' here: dotenv turns \r/\n into literal r/n before the
# shell runs, so tr deletes those letters from the token and login fails.
KAMAL_REGISTRY_PASSWORD=$(ruby -e 'print File.read("config/registry.yml").strip')

NEXT_PUBLIC_MARKETER_PORTAL_URL=$(sed -n 's/^NEXT_PUBLIC_MARKETER_PORTAL_URL=//p' .env.production 2>/dev/null | head -1)
